# ==============================================================================
# LangGraph Multi-Agent System - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to: .env
# 2. Fill in the values for the placeholders below.
# 3. NEVER commit your actual .env file to Git.
# ==============================================================================

# --- LLM & Embeddings Provider (OpenAI) ---
# Used for the main agent, router, RAG generation, and embeddings
OPENAI_API_KEY=your_openai_api_key_here

# --- Hosted Vector Store (Pinecone) ---
# Sign up for free at https://www.pinecone.io/
# Create an index with dimension: 1536 (for text-embedding-3-small) and metric: cosine
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=langgraph-rag-index

# --- GitHub MCP Sub-Agent ---
# Generate a Personal Access Token (classic or fine-grained) at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here

# --- Google Workspace MCP Sub-Agent (Composio - Calendar & Gmail) ---
# Connect your Google Calendar and Gmail accounts in Composio: https://app.composio.dev/
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_USER_ID=default
CALENDAR_CONNECTION_ID=your_calendar_connection_id_here
GMAIL_CONNECTION_ID=your_gmail_connection_id_here
